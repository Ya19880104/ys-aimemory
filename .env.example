# Copy to .env on the VM; provide your own secrets. Never commit .env.
# Leave no required field blank. No usable credentials are supplied.
POSTGRES_PASSWORD=
# Separate least-privilege application database role password.
HUB_DB_PASSWORD=
# URL-encode password special characters. DB host is db, user/db are memory_hub.
# Format: postgresql+psycopg://memory_hub:URL_ENCODED_HUB_DB_PASSWORD@db:5432/memory_hub
HUB_DATABASE_URL=
# Single-quote the JSON to prevent Compose interpolation of its contents.
# Each identity needs a distinct random token (>=24 chars), explicit project list,
# and least-privilege role. Do not share the approver/admin token with workers.
# Shape: '{"OPERATOR_TOKEN":{"worker_id":"codex","projects":["project-a"],"role":"worker"}}'
# Configure four distinct identities appropriate to your clients/operator.
HUB_AUTH_TOKENS=
HUB_ALLOWED_HOSTS=localhost,127.0.0.1
HUB_HTTP_PORT=8000
# Optional TLS profile: operator must explicitly choose the VM's private LAN IP
# and append the certificate hostname to HUB_ALLOWED_HOSTS. Never use 0.0.0.0.
HUB_HTTPS_BIND_IP=127.0.0.1
HUB_HTTPS_PORT=8443
# Both HTTPS and HTTP bootstrap use this bind address. The legacy
# HUB_HTTPS_BIND_IP remains a fallback when HUB_BIND_HOST is absent.
# HTTP serves GET/HEAD /help and /downloads/ys-ai-memory-ca.crt only.
HUB_BIND_HOST=127.0.0.1
HUB_BOOTSTRAP_PORT=80
# Exact externally reachable HTTPS authority, e.g. https://hub.example.test:8443.
# Empty safely generates https://localhost links; configure before LAN onboarding.
HUB_PUBLIC_BASE_URL=
# Compose fixes this container path; place ONLY the public CA in nginx/public/.
HUB_PUBLIC_CA_FILE=/app/public/ys-ai-memory-ca.crt

# Optional dashboard (read-only by default): fill ALL three fields to enable password login.
# No default username/password. Generate a hash interactively using:
#   python -m memory_hub.web_password
# Single-quote the complete scrypt$... hash, preserving every dollar sign.
HUB_WEB_USERNAME=
HUB_WEB_PASSWORD_HASH=
HUB_WEB_PROJECTS=
HUB_WEB_SESSION_TTL=3600
# Only an operator should opt in to admin web writes within HUB_WEB_PROJECTS.
HUB_WEB_ROLE=read_only
# UI default. Each browser may select English or Traditional Chinese independently.
HUB_WEB_LANGUAGE=en
# Optional display labels; worker IDs and authorization remain unchanged.
HUB_WORKER_DISPLAY_NAMES=
# Explicit opt-in for human-owned memory libraries and worker token management.
HUB_WEB_MCP_ENABLED=false
HUB_WEB_OWNER_ID=
# Target Compose always uses Secure cookies; open /ui through HTTPS.
# For isolated local Python HTTP tests ONLY, use HUB_WEB_COOKIE_SECURE=false
# outside Compose. Never set this for LAN/public deployments.
